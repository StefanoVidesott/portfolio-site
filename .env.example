ENVIRONMENT=dev

# Server-side base URL used by this container to call the CMS/ERP API.
# Inside Docker, containers reach each other via host.docker.internal.
# Dev:  http://host.docker.internal:8004
# Prod: https://cms.yourdomain.com (same as CMS_PUBLIC_ORIGIN in prod)
CMS_API_BASE_URL=http://host.docker.internal:8004

# Public-facing origin of the CMS, as reachable by the *browser*.
# Used in the Content-Security-Policy img-src directive so the browser is
# allowed to load images served by the CMS. Must NOT be host.docker.internal
# because browsers on the host machine cannot resolve that hostname.
# Dev:  http://localhost:8004
# Prod: https://cms.yourdomain.com (same as CMS_API_BASE_URL in prod)
CMS_PUBLIC_ORIGIN=http://localhost:8004

SMTP_SERVER=smtp.gmail.com
SMTP_PORT=465
SENDER_EMAIL=la_tua_email@gmail.com
SENDER_PASSWORD=la_tua_app_password
RECEIVER_EMAIL=la_tua_email@gmail.com

TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

CLOUDFLARE_WEB_ANALYTICS_TOKEN=
SENTRY_DSN=
